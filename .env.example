# ─── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local: PostgreSQL embebido → `npm run db:up` (deja la terminal abierta)
# Producción (Azure): cadena de conexión de Azure Database for PostgreSQL Flexible Server
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sisas_ansi?schema=public"

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generar uno por entorno: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"
# URL canónica de la app (en producción: https://tu-app.azurewebsites.net)
AUTH_URL="http://localhost:3000"

# ─── URL pública ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
